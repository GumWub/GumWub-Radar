<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/admin_login_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SECURE AREA"
        android:textColor="@color/accent"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.18"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Admin login"
        android:textColor="@color/text_primary"
        android:textSize="25sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="16dp"
        android:text="Sign in with your admin account to manage the radar system."
        android:textColor="@color/muted"
        android:textSize="13sp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Username"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/accent"
        app:hintTextColor="@color/accent"
        app:startIconDrawable="@android:drawable/ic_menu_myplaces"
        app:startIconTint="@color/muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/adminUsernameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/muted"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Password"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/accent"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/muted"
        app:hintTextColor="@color/accent"
        app:startIconDrawable="@android:drawable/ic_lock_lock"
        app:startIconTint="@color/muted">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/adminPasswordInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/muted"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/adminLoginError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/warning"
        android:textSize="12sp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/adminLoginSubmit"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:text="Sign in"
        android:textAllCaps="false"
        android:textColor="@color/background"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/accent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/adminLoginCancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/muted"/>
</LinearLayout>
